root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
# rustfmt owns these files; the values here only steer an editor before it runs.
indent_size = 4
max_line_length = 100

[*.md]
# Hard line breaks in markdown are two trailing spaces.
trim_trailing_whitespace = false

[Cargo.lock]
insert_final_newline = unset
trim_trailing_whitespace = unset

[CHANGELOG.md]
# Generated by release-plz via git-cliff.
insert_final_newline = unset
trim_trailing_whitespace = unset
