// hk configuration for autocomplete-rs
// Install via mise: mise install
// Setup git hooks: hk install

amends "package://github.com/jdx/hk/releases/download/v1.35.0/hk@1.35.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.35.0/hk@1.35.0#/Builtins.pkl"

// Ensure mise-managed tools are on PATH (needed for IDEs/non-interactive shells)
env {
  ["PATH"] = read("env:HOME") + "/.local/share/mise/shims:" + read("env:PATH")
}

// Configure git hooks
hooks {
  // Run formatting and linting checks before commit
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      // Rust tools — overridden from builtins to match CI flags exactly.
      // Builtins use minimal flags; CI uses --all-targets --all-features.
      ["cargo_fmt"] {
        glob = "*.rs"
        check = "cargo fmt --all -- --check"
        fix = "cargo fmt --all"
      }
      ["cargo_clippy"] {
        glob = "*.rs"
        check = "cargo clippy --locked --all-targets --all-features -- -D warnings"
        fix = "cargo clippy --fix --allow-dirty --allow-staged --locked --all-targets --all-features"
      }
      ["cargo_check"] {
        glob = "*.rs"
        check = "cargo check --locked --all-targets --all-features -q"
      }

      // Non-Rust formatting
      ["prettier"] = Builtins.prettier

      // taplo: override builtin to use `taplo fmt` (formatting check)
      // instead of `taplo check` (syntax-only validation).
      ["taplo"] {
        glob = "*.toml"
        check = "taplo fmt --check {{files}}"
        fix = "taplo fmt {{files}}"
      }

      // Markdown linting (custom - uses markdownlint-cli2)
      ["markdown_lint"] {
        glob = "*.md"
        check = "markdownlint-cli2 {{files}}"
        fix = "markdownlint-cli2 --fix {{files}}"
      }

      // Beads: export Dolt database to JSONL before commit
      ["bd_pre_commit"] {
        check = "TERM=dumb bd hook pre-commit --quiet"
      }
    }
  }

  // Run full test suite before push
  ["pre-push"] {
    steps {
      ["test"] {
        check = "cargo nextest run --locked --all-features --no-tests=warn"
      }
    }
  }

  // Validate conventional commit format
  ["commit-msg"] {
    steps {
      ["conventional_commit"] {
        check = "cog verify --file {{commit_msg_file}}"
      }
    }
  }

  // Beads: import JSONL into Dolt after pull/merge
  ["post-merge"] {
    steps {
      ["bd_post_merge"] {
        check = "TERM=dumb bd hook post-merge --quiet"
      }
    }
  }

  // Beads: import JSONL into Dolt after branch checkout
  ["post-checkout"] {
    steps {
      ["bd_post_checkout"] {
        check = "TERM=dumb bd hook post-checkout --quiet"
      }
    }
  }
}
